# Air System - Environment Configuration Template
# Copy this file to .env and update with your production values
# DO NOT commit the actual .env file to version control

# ======================
# APPLICATION SETTINGS
# ======================

# Environment: development, testing, or production
CI_ENV=production

# Base URL (include trailing slash)
# Example: https://yourdomain.com/ or https://yourdomain.com/air-system/
BASE_URL=https://yourdomain.com/air-system/

# ======================
# SECURITY
# ======================

# Encryption Key (32 characters minimum)
# Generate using: php -r "echo bin2hex(random_bytes(16));"
ENCRYPTION_KEY=a7s9d8f7g6h5j4k3l2m1n0p9o8i7u6y5

# Enable/Disable CSRF Protection (TRUE or FALSE)
CSRF_PROTECTION=TRUE

# ======================
# DATABASE SETTINGS
# ======================

# Database Driver (mysqli, pdo, etc.)
DB_DRIVER=mysqli

# Database Host
DB_HOST=localhost

# Database Port (usually 3306 for MySQL)
DB_PORT=3306

# Database Name
DB_NAME=air_system

# Database Username
DB_USERNAME=your_db_username

# Database Password
DB_PASSWORD=your_secure_db_password

# Database Prefix (optional)
DB_PREFIX=

# Database Charset
DB_CHARSET=utf8

# Database Collation
DB_COLLATION=utf8_general_ci

# ======================
# SESSION SETTINGS
# ======================

# Session Driver: files, database, redis, memcached
SESS_DRIVER=files

# Session Cookie Name
SESS_COOKIE_NAME=as_session

# Session Expiration (in seconds, 7200 = 2 hours)
SESS_EXPIRATION=7200

# Session Save Path (leave empty for default)
# SESS_SAVE_PATH=/path/to/sessions

# ======================
# EMAIL SETTINGS
# ======================

# Email Protocol: mail, sendmail, smtp
EMAIL_PROTOCOL=smtp

# SMTP Host
SMTP_HOST=smtp.gmail.com

# SMTP Port (465 for SSL, 587 for TLS)
SMTP_PORT=587

# SMTP Username
SMTP_USER=your_email@domain.com

# SMTP Password
SMTP_PASS=your_email_password

# SMTP Encryption: ssl or tls
SMTP_CRYPTO=tls

# Email From Address
EMAIL_FROM=noreply@yourdomain.com

# Email From Name
EMAIL_FROM_NAME=Air System

# ======================
# FILE UPLOAD SETTINGS
# ======================

# Maximum Upload Size (in MB)
MAX_UPLOAD_SIZE=10

# Allowed File Types (comma-separated)
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx

# Upload Path (relative to project root)
UPLOAD_PATH=./uploads/

# ======================
# LOGGING
# ======================

# Log Threshold: 0=Disabled, 1=Error, 2=Debug, 3=Info, 4=All
LOG_THRESHOLD=1

# Log Path (relative to application folder)
LOG_PATH=logs/

# ======================
# TIMEZONE
# ======================

# PHP Timezone
TIMEZONE=Asia/Jakarta

# ======================
# MAINTENANCE MODE
# ======================

# Enable Maintenance Mode (TRUE or FALSE)
MAINTENANCE_MODE=FALSE

# Maintenance Mode Message
MAINTENANCE_MESSAGE=System under maintenance. Please check back soon.

# ======================
# CACHE SETTINGS
# ======================

# Cache Driver: file, memcached, redis, dummy
CACHE_DRIVER=file

# Cache Default TTL (in seconds)
CACHE_TTL=3600

# ======================
# API SETTINGS (if applicable)
# ======================

# API Keys or Third-party Service Credentials
# API_KEY=your_api_key_here
# API_SECRET=your_api_secret_here

# ======================
# NOTES
# ======================
# - Always use strong passwords and keys in production
# - Ensure .env file has proper permissions (600 or 400)
# - Never commit .env to version control
# - Update all placeholder values before deployment
