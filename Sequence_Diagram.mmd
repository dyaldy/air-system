sequenceDiagram
    actor User as Pengguna
    participant View as Tampilan (UI)
    participant Auth as Kontroler Autentikasi
    participant Home as Kontroler Beranda
    participant Storage as Kontroler Penyimpanan
    participant S_Model as Storage_model
    participant P_Model as Project_batch_model
    participant R_Model as Report_model
    participant DB as Basis Data

    %% ==========================================
    %% 1. Proses Login
    %% ==========================================
    Note over User, DB: Alur Autentikasi
    User->>View: Akses Halaman Login
    User->>View: Masukkan NIK
    View->>Auth: POST /auth/index (nik)
    Auth->>DB: User_model->getByNik(nik)
    DB-->>Auth: Mengembalikan Data Pengguna
    
    alt Pengguna Tidak Ditemukan
        Auth-->>View: Set Pesan Error (Flashdata)
        View-->>User: Tampilkan "NIK tidak terdaftar"
    else Pengguna Ditemukan
        Auth->>Auth: Set Data Sesi
        Auth-->>View: Alihkan ke Beranda
        View-->>User: Tampilkan Dashboard
    end

    %% ==========================================
    %% 2. Memuat Dashboard
    %% ==========================================
    Note over User, DB: Dashboard & Peringatan
    User->>Home: GET /home
    Home->>DB: Hitung Pengguna, Pneumatic, Fitting
    Home->>DB: Storage_model->countStorageLocations()
    Home->>S_Model: get_low_stock_items()
    S_Model->>DB: Query item < min_stock
    DB-->>S_Model: Kembalikan Daftar Stok Rendah
    Home-->>View: Render Dashboard (Statistik + Peringatan)

    %% ==========================================
    %% 3. Simpan Barang (Reguler & Proyek)
    %% ==========================================
    Note over User, DB: Operasi Penyimpanan - Simpan
    User->>View: Isi Formulir Simpan (Lokasi, Barang, Jml)
    opt Apakah Proyek?
        User->>View: Centang "Barang Proyek", Masukkan Nama Proyek
    end
    View->>Storage: POST /storage/store
    
    Storage->>Storage: Validasi Input & Keberadaan Barang
    
    alt Validasi Gagal
        Storage-->>View: Alihkan dengan Error
    else Validasi Berhasil
        
        alt Adalah Barang Proyek
            Storage->>P_Model: create_batch(lokasi, tipe, nama_proyek, jml...)
            P_Model->>DB: INSERT ke as_project_batches
            DB-->>P_Model: Kembalikan batch_id
        end

        Storage->>S_Model: store_items(lokasi, kategori, type_id, jml...)
        S_Model->>DB: Cek apakah penyimpanan ada
        alt Ada
             S_Model->>DB: UPDATE as_storage SET amount = amount + qty
        else Baru
             S_Model->>DB: INSERT ke as_storage
        end
        
        Storage->>R_Model: log_store_transaction(...)
        R_Model->>DB: INSERT ke as_report
        
        Storage-->>View: Alihkan ke Tampilan Lokasi
        View-->>User: Tampilkan Pesan Sukses
    end

    %% ==========================================
    %% 4. Ambil Barang (Reguler & Proyek)
    %% ==========================================
    Note over User, DB: Operasi Penyimpanan - Ambil
    User->>View: Klik "Ambil" pada Barang
    View->>Storage: POST /storage/take
    
    alt Adalah Batch Proyek (terdeteksi dari _project di lokasi atau batch_id)
        Storage->>P_Model: take_from_specific_batch(batch_id, jml)
        P_Model->>DB: UPDATE as_project_batches SET remaining_qty...
        
        alt Update Batch Gagal
            P_Model-->>Storage: Kembalikan Error
            Storage-->>View: Tampilkan Error
        end
    end

    Storage->>S_Model: take_items(lokasi, kategori, type_id, jml...)
    S_Model->>DB: Cek Stok Saat Ini
    
    alt Stok Tidak Cukup / Update Gagal
        S_Model-->>Storage: Kembalikan Error
        
        opt Adalah Batch Proyek
            Note right of Storage: Rollback Update Batch
            Storage->>P_Model: add_back_to_batch(batch_id, jml)
            P_Model->>DB: UPDATE as_project_batches (Kembalikan Jml)
        end
        
        Storage-->>View: Tampilkan Error
    else Stok Cukup
        S_Model->>DB: UPDATE as_storage SET amount = amount - qty
        
        Storage->>R_Model: log_take_transaction(...)
        R_Model->>DB: INSERT ke as_report
        
        Storage-->>View: Alihkan ke Tampilan Lokasi
        View-->>User: Tampilkan Pesan Sukses
    end
