flowchart TD
    %% Styles
    classDef entity fill:#bbdefb,stroke:#1565c0,stroke-width:2px;
    classDef process fill:#e1bee7,stroke:#4a148c,stroke-width:2px,rx:10,ry:10;
    classDef store fill:#fff9c4,stroke:#fbc02d,stroke-width:2px;

    %% ==========================================
    %% Level 0: Diagram Konteks
    %% ==========================================
    subgraph Level0 [Level 0: Diagram Konteks]
        direction LR
        User0[Pengguna / Admin]:::entity
        System0((0.0<br/>Air System)):::process
        
        User0 -->|Kredensial Login<br/>Permintaan Simpan/Ambil<br/>Detail Barang<br/>Data Pengguna<br/>Filter Laporan| System0
        System0 -->|Status Autentikasi<br/>Statistik Dashboard<br/>Peringatan Stok Rendah<br/>Log Transaksi<br/>Operasi Sukses/Gagal| User0
    end

    %% ==========================================
    %% Level 1: Diagram Alir Data
    %% ==========================================
    subgraph Level1 [Level 1: Diagram Alir Data]
        direction TB
        
        %% External Entity
        User1[Pengguna / Admin]:::entity

        %% Processes
        P1((1.0<br/>Autentikasi)):::process
        P2((2.0<br/>Dashboard &<br/>Pemantauan)):::process
        P3((3.0<br/>Operasi<br/>Penyimpanan)):::process
        P4((4.0<br/>Manajemen<br/>Barang)):::process
        P5((5.0<br/>Administrasi<br/>Pengguna)):::process
        P6((6.0<br/>Pelaporan &<br/>Analitik)):::process

        %% Data Stores
        D1[(D1 Pengguna)]:::store
        D2[(D2 Penyimpanan)]:::store
        D3[(D3 Barang)]:::store
        D4[(D4 Batch Proyek)]:::store
        D5[(D5 Laporan)]:::store

        %% 1.0 Auth Flows
        User1 -->|NIK| P1
        P1 <-->|Validasi Pengguna| D1
        P1 -->|Token Sesi| User1

        %% 2.0 Dashboard Flows
        User1 -->|Minta Tampilan| P2
        P2 <-->|Hitung/Cek Stok| D2
        P2 <-->|Hitung Barang| D3
        P2 -->|Statistik & Peringatan| User1

        %% 3.0 Storage Flows
        User1 -->|Permintaan Simpan/Ambil| P3
        P3 -->|Perbarui Kuantitas| D2
        P3 <-->|Kelola Batch| D4
        P3 -->|Catat Transaksi| D5
        P3 -->|Konfirmasi| User1

        %% 4.0 Inventory Flows
        User1 -->|Detail Barang| P4
        P4 -->|Operasi CRUD| D3

        %% 5.0 User Mgmt Flows
        User1 -->|Detail Pengguna| P5
        P5 -->|Operasi CRUD| D1

        %% 6.0 Reporting Flows
        User1 -->|Kriteria Filter| P6
        P6 <-->|Ambil Log| D5
        P6 -->|Laporan Terbentuk| User1
    end
