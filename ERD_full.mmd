    }

    as_project_batches {
        varchar batch_id PK "varchar(50)"
        varchar location_id FK "varchar(17) - Link to Storage"
        varchar category FK "varchar(15) - Link to Storage"
        varchar type_id FK "varchar(50) - Link to Storage"
